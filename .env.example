# Copy to .env (git-ignored) and fill in locally. Never commit real keys.
# Only the variables for the providers you actually use need a value.

# Optional API providers (status: unverified in config/models.csv)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# vLLM OpenAI-compatible server on bwUniCluster (main path for open-weight models)
# e.g. http://<compute-node>:8000/v1  (reach it through an SSH tunnel from a login node)
VLLM_BASE_URL=
# Must match the --api-key given to `vllm serve`; leave empty if the server has none.
VLLM_API_KEY=

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# Secrets: never commit keys. Copy .env.example to .env and fill it locally.
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# LaTeX build artefacts (paper folders and research/)
paper/**/*.aux
paper/**/*.bbl
paper/**/*.blg
paper/**/*.fdb_latexmk
paper/**/*.fls
paper/**/*.log
paper/**/*.out
paper/**/*.synctex.gz
research/*.aux
research/*.bbl
research/*.blg
research/*.fdb_latexmk
research/*.fls
research/*.log
research/*.out
research/*.synctex.gz

# --- Run outputs policy (see data/README.md) ---
# Mock runs are synthetic, regenerable in seconds, and must never be mistaken for
# results, so they are NOT committed. By convention every mock run id starts with
# "mock".
data/raw/mock*/
data/processed/mock*/
results/mock*/
#
# Real-run raw outputs (data/raw/<run_id>/) are deliberately NOT ignored: they are
# the primary evidence and are committed. Do not add an ignore rule for them.
# Processed tables are regenerable from raw but are small and are committed too.

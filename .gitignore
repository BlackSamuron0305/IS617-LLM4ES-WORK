# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# Secrets: never commit keys. Keep them in a local .env file.
.env
.env.*

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# LaTeX build artefacts (paper folders and research/)
paper/**/*.aux
paper/**/*.bbl
paper/**/*.blg
paper/**/*.fdb_latexmk
paper/**/*.fls
paper/**/*.log
paper/**/*.out
paper/**/*.synctex.gz
research/**/*.aux
research/**/*.bbl
research/**/*.blg
research/**/*.fdb_latexmk
research/**/*.fls
research/**/*.log
research/**/*.out
research/**/*.synctex.gz

# --- Run outputs policy (see data/README.md) ---
# Mock runs are synthetic, regenerable in seconds, and must never be mistaken for
# results, so they are NOT committed. By convention every mock run id starts with
# "mock".
data/raw/mock*/
data/processed/mock*/
results/mock*/
#
# Real-run raw outputs (data/raw/<run_id>/) are the primary evidence and are committed, as compressed
# files (answers.jsonl.gz; pipeline/common.py reads them like the plain file). The plain .jsonl copies are
# ignored. Processed tables are regenerable from raw with the pipeline and are 800 MB together, so they
# are not committed; the small summary tables are in results/.
data/raw/**/*.jsonl
data/processed/

# Job logs from the cluster (cluster/README.md) and notes of the AI working sessions
logs/
.superpowers/

# Office lock files
~$*
